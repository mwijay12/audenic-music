{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audenic",
  "version": "2.0.0",
  "identifier": "fm.audenic.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Audenic Studio",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": true,
        "theme": "Dark"
      },
      {
        "label": "widget",
        "title": "Audenic Music Widget",
        "url": "index.html#/widget",
        "width": 380,
        "height": 165,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["mp3", "flac", "wav", "ogg", "m4a", "aac", "wma", "opus"], "mimeType": "audio/*", "description": "Audio File" },
      { "ext": ["mp4", "webm", "mkv", "avi", "mov"], "mimeType": "video/*", "description": "Video File" }
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
