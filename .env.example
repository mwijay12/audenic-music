# =========================================================
# Audenic Music — Environment Variables Template
# Copy this file to `.env` and populate with your API keys.
# =========================================================

# Comma-separated Gemini API keys for AI assistant & lyrics
VITE_GEMINI_KEYS=

# Comma-separated Groq API keys for fast offline/fallback inference
VITE_GROQ_KEYS=

# Comma-separated OpenRouter API keys
VITE_OPENROUTER_KEYS=

# Comma-separated ElevenLabs TTS / voice synthesis keys
VITE_ELEVENLABS_TTS_KEYS=

# Comma-separated ElevenLabs sound effects / bed generation keys
VITE_ELEVENLABS_SFX_KEYS=

# Comma-separated Ollama Cloud API keys
VITE_OLLAMA_KEYS=

# News API keys for culture & music feeds
VITE_NEWSAPI_KEYS=
VITE_GUARDIAN_KEY=
VITE_GNEWS_KEYS=

# Cloudflare R2 direct audio storage (Optional for custom cloud sync)
VITE_R2_ACCESS_KEY_ID=
VITE_R2_SECRET_ACCESS_KEY=
VITE_R2_ENDPOINT=
VITE_R2_BUCKET_NAME=
VITE_R2_PUBLIC_URL=https://pub-c26084d7ca874fcda47de161be8ded27.r2.dev
